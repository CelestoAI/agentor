# Manifest syntax: https://packaging.python.org/en/latest/guides/using-manifest-in/
#
# Rules for paths this repository does not have were dropped: `graft wheelhouse`,
# `include requirements.txt`, `recursive-include _requirements *.tx;t` (also a
# typo for *.txt), `exclude Makefile`, `recursive-exclude site *` and
# `prune temp*`. The wheel contents come from [tool.hatch.build] in
# pyproject.toml; this file only shapes the sdist.

recursive-exclude __pycache__  *.py[cod] *.orig

# Include the README and the license
include *.md
recursive-include src *.md
include LICENSE

# Exclude build configs
exclude *.sh
exclude *.toml
exclude *.svg
exclude *.yml
exclude *.yaml

# Exclude tests, docs and images from the package
recursive-exclude tests *
exclude tests
recursive-exclude docs *
exclude docs

prune .git
prune .github
prune test*
prune assets/*
prune docs/*
